meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "user@example.com",
    "password": "newpassword123"
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body && body.status === true && body.data && body.data.token) {
    
    bru.setVar("token", body.data.token);
    bru.setVar("refresh_token",body.data.refresh_token)
    console.log("Đã lưu accessToken thành công:", body.data.token);
    
  } else {
    console.log("Không tìm thấy token trong phản hồi API.");
  }
}
